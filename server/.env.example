# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# TiDB Cloud (leave TIDB_HOST empty to use in-memory storage)
TIDB_HOST=
TIDB_PORT=4000
# Optional: set exact frontend origin(s) for production or custom development hosts.
# CLIENT_ORIGIN=http://localhost:5173
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=lifequest
